# Production build config for the frontend (used by `npm run build`).
# Vite inlines these values at build time.

# When the frontend is served from the same domain as the API (nginx setup),
# you can leave this empty so the browser uses relative /api paths.
# If the API lives on a separate host, set the full URL:
# VITE_API_BASE=https://api.yourdomain.com
VITE_API_BASE=