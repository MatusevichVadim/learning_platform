# Backend environment configuration.
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit real secrets.

# Secret key for JWT signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-to-a-random-secret-key

# Admin bootstrap credentials (used to (re)create the default admin account).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Token lifetime in minutes (default 7 days = 10080).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Set to 1/true to add the Secure flag to cookies (requires HTTPS in production).
SECURE_COOKIES=false

# Comma separated list of allowed CORS origins.
# Local dev:   http://localhost:5173,http://127.0.0.1:5173
# Production:  https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database path (sqlite) or full DATABASE_URL (e.g. postgresql://user:pass@host/db).
# Local:  ./backend_data.sqlite3
# Prod:   /var/lib/learning-platform/production.db
DB_PATH=./backend_data.sqlite3