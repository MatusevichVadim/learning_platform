# Backend environment configuration.
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit real secrets.

# Secret key for JWT signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-to-a-random-secret-key

# Admin bootstrap credentials (used to (re)create the default admin account).
# Admin login is restricted to these credentials only - no other user can log in as admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Token lifetime in minutes (default 7 days = 10080).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Set to 1/true to add the Secure flag to cookies (requires HTTPS in production).
SECURE_COOKIES=false

# Comma separated list of allowed CORS origins.
# Local dev:   http://localhost:5173,http://127.0.0.1:5173
# Production:  https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration.
# For production with 15+ concurrent users, use PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/learning_platform
# For local development, SQLite is fine:
#   DB_PATH=./backend_data.sqlite3
# If DATABASE_URL is set, it takes precedence over DB_PATH.
DB_PATH=./backend_data.sqlite3
# DATABASE_URL=postgresql://learning:yourpassword@localhost:5432/learning_platform

# Connection pool settings (PostgreSQL only; SQLite ignores these).
# pool_size: number of persistent connections in the pool.
# max_overflow: additional connections allowed beyond pool_size.
# pool_timeout: seconds to wait for a connection before erroring.
# pool_recycle: recycle connections after this many seconds (prevents stale connections).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800